# Frontend — backend base URL (single source of truth via frontend/src/lib/api.ts)
# Set this to the deployed backend URL in production, leave unset for local dev against http://localhost:8000.
# The dev proxy (vite.config.ts) also reads this same var via loadEnv, so runtime and proxy stay in sync.
#
# Examples:
# VITE_API_BASE_URL=http://localhost:8000
# VITE_API_BASE_URL=https://bis-api.example.com
# VITE_API_BASE_URL=https://api.bis.example.in
#
# If unset, the app falls back to http://localhost:8000 — no code changes needed elsewhere.
VITE_API_BASE_URL=http://localhost:8000
